# Runtime configuration for staging/production. All optional.
# The container writes these into /env.js at start. Leave blank to run
# with no error tracking and no analytics. Never commit real values.

# Sentry (GlitchTip-compatible) DSN for frontend error tracking.
SENTRY_DSN=

# Umami analytics script URL (e.g. https://umami.example.com/script.js).
UMAMI_URL=

# Umami website id for this app.
UMAMI_WEBSITE_ID=

# Set to 1 to seed a sample palace on the very first boot, when no atlas
# exists yet. Meant for demo and staging deployments.
SEED_DEMO=
